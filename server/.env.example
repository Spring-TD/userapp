# ==========================================
# Shared Environment Variables
# ==========================================

# Database - Use MongoDB Atlas for production 
DATABASE_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/springtd?retryWrites=true&w=majority

# Redis - Use your cloud Redis or local
REDIS_URL=redis://localhost:6379

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Email Configuration (SMTP)
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
FROM_EMAIL=noreply@springtd.com

# Cloudinary Configuration (for compliance-ms)
CLOUDINARY_CLOUD_NAME=your-cloudinary-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Payment Gateway Configuration (for payment-ms)
PAYMENT_GATEWAY_API_KEY=your-payment-gateway-api-key
PAYMENT_GATEWAY_SECRET=your-payment-gateway-secret
PAYMENT_GATEWAY_WEBHOOK_SECRET=your-webhook-secret

# Application Keys (for create-app-ms)
SPECIAL_API_KEY=your-special-api-key-here
PUBLIC_KEY=your-public-key-here

# Logging
LOG_LEVEL=info
