          }
        }
      }
    },
    "/api/v1/records/{recordId}/ledger/entry": {
      "post": {
        "summary": "Add ledger entry (debit/credit)",
        "tags": [
          "Records - Ledger"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "recordId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "entryType",
                  "debitAmount",
                  "transactionDescription",
                  "transactionType",
                  "txnRef",
                  "sessionId",
                  "fromCurrency",
                  "toCurrency",
                  "senderInfo",
                  "feeBreakdown"
                ],
                "properties": {
                  "entryType": {
                    "type": "string",
                    "enum": [
                      "DEBIT",
                      "CREDIT"
                    ]
                  },
                  "debitAmount": {
                    "type": "number"
                  },
                  "transactionDescription": {
                    "type": "string"
                  },
                  "transactionType": {
                    "type": "string"
                  },
                  "financialCategory": {
                    "type": "string",
                    "enum": [
                      "LOAN",
                      "SAVINGS",
                      "MORTGAGE",
                      "COMMODITY",
                      "WALLET"
                    ]
                  },
                  "txnRef": {
                    "type": "string"
                  },
                  "sessionId": {
                    "type": "string"
                  },
                  "fromCurrency": {
                    "type": "string"
                  },
                  "toCurrency": {
                    "type": "string"
                  },
                  "senderInfo": {
                    "type": "object",
                    "properties": {
                      "full_name": {
                        "type": "string"
                      },
                      "email": {
                        "type": "string"
                      },
                      "phone": {
                        "type": "string"
                      }
                    }
                  },
                  "feeBreakdown": {
                    "type": "object",
                    "properties": {
                      "payout_fee": {
                        "type": "number"
                      },
                      "merchant_commission": {
                        "type": "number"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Ledger entry added"
          },
          "400": {
            "description": "Missing or invalid fields"
          }
        }
      }
    },
