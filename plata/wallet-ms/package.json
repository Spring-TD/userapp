{
  "name": "wallet-ms",
  "version": "1.0.0",
  "description": "Wallet Microservice for SpringTD Platform",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:wallets": "ts-node src/utils/testWallets.ts",
    "test:user": "ts-node src/utils/testUserWallet.ts",
    "test:treasury": "ts-node src/utils/testTreasury.ts",
    "test:operation": "ts-node src/utils/testOperationWallet.ts",
    "test:kyc": "ts-node src/utils/testKycWallet.ts",
    "test:opkyc": "ts-node src/utils/testOperationKyc.ts",
    "test:kycfee": "ts-node src/utils/testKycFee.ts",
    "test:treasurydebit": "ts-node src/utils/testTreasuryDebit.ts",
    "test:autoprovision": "ts-node src/utils/testAutoProvision.ts",
    "test:apicall": "ts-node src/utils/testUserApiCall.ts",
    "test:funding": "ts-node src/utils/testFundingCallback.ts",
    "test:merchant-funding": "ts-node src/utils/testMerchantFundingCallback.ts",
    "test:transaction-fields": "ts-node src/utils/testTransactionFields.ts",
    "test:balance-fields": "ts-node src/utils/testBalanceFields.ts",
    "test:ledger-structure": "ts-node src/utils/testLedgerStructure.ts",
    "test:funding-controller": "ts-node src/utils/testFundingController.ts"
  },
  "keywords": [
    "wallet",
    "microservice",
    "finance",
    "typescript",
    "nodejs"
  ],
  "author": "SpringTD Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.4.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "mongoose": "^9.2.1",
    "morgan": "^1.10.1",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.4.5",
    "jest": "^29.6.2",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
