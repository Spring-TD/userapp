{
  "openapi": "3.0.0",
  "info": {
    "title": "Wallet Microservice API",
    "version": "1.0.0",
    "description": "Wallet, transaction, and funding APIs"
  },
  "servers": [
    {
      "url": "http://localhost:3004",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/transactions/{walletId}": {
      "get": {
        "summary": "Get transaction history for wallet",
        "tags": [
          "Transactions"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "walletId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of transactions for the wallet"
          },
          "404": {
            "description": "Wallet not found or failed to retrieve history"
          }
        }
      }
    },
    "/api/v1/wallets/merchant": {
      "post": {
        "summary": "Create merchant wallet",
        "tags": [
          "Wallets - Merchant"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "currency",
                  "merchantWalletType"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "currency": {
                    "type": "string",
                    "minLength": 3,
                    "maxLength": 3
                  },
                  "merchantWalletType": {
                    "type": "string",
                    "enum": [
                      "TREASURY",
                      "OPERATION",
                      "KYC"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Merchant wallet created"
          }
        }
      }
    },
    "/api/v1/wallets/merchant/all": {
      "post": {
        "summary": "Create all merchant wallets (Treasury, Operation, KYC)",
        "tags": [
          "Wallets - Merchant"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "currency": {
                    "type": "string",
                    "default": "USD"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "All merchant wallets created"
          }
        }
      }
    },
    "/api/v1/wallets/merchant/{merchantId}/type/{walletType}": {
      "get": {
        "summary": "Get merchant wallet by type",
        "tags": [
          "Wallets - Merchant"
