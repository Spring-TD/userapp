    "/api/v1/wallets/funding/callback": {
      "post": {
        "summary": "Funding callback (payment provider webhook)",
        "tags": [
          "Wallets - Funding"
        ],
        "description": "Public endpoint; no auth. Called by payment providers when funding completes.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "amount",
                  "currency",
                  "transactionId",
                  "paymentMethod",
                  "status"
                ],
                "properties": {
                  "walletId": {
                    "type": "string"
                  },
                  "userId": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  },
                  "currency": {
                    "type": "string"
                  },
                  "transactionId": {
                    "type": "string"
                  },
                  "paymentMethod": {
                    "type": "string",
                    "enum": [
                      "CARD",
                      "BANK_TRANSFER",
                      "WALLET",
                      "OTHER"
                    ]
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "SUCCESS",
                      "COMPLETED",
                      "PENDING",
                      "FAILED",
                      "CANCELLED"
                    ]
                  },
                  "description": {
                    "type": "string"
                  },
                  "providerReference": {
                    "type": "string"
                  },
                  "merchantId": {
                    "type": "string"
                  },
                  "merchantWalletType": {
                    "type": "string",
                    "enum": [
                      "TREASURY",
                      "OPERATION",
                      "KYC"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Callback processed"
          }
        }
      }
    },
