{
  "openapi": "3.0.0",
  "info": {
    "title": "Service Auth Microservice (SAMS) API",
    "version": "1.0.0",
    "description": "Service-to-service authentication and management APIs"
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  },
  "paths": {
    "/api/v1/keys": {
      "get": {
        "summary": "List API keys",
        "tags": [
          "API Keys"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "List of API keys"
          }
        }
      },
      "post": {
        "summary": "Create API key",
        "tags": [
          "API Keys"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "API key created"
          }
        }
      }
    },
    "/api/v1/keys/{keyId}": {
      "delete": {
        "summary": "Revoke API key",
        "tags": [
          "API Keys"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "keyId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "API key revoked"
          }
        }
      }
    },
    "/api/v1/credentials/validate": {
      "post": {
        "summary": "Validate credential",
        "tags": [
          "Credentials"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "clientId": {
                    "type": "string"
                  },
                  "clientSecret": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Validation result"
          }
        }
      }
    },
    "/api/v1/credentials/void/{credentialId}": {
      "post": {
        "summary": "Void credential",
        "tags": [
          "Credentials"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "credentialId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Credential voided"
          }
        }
      }
    },
    "/api/v1/credentials/{credentialId}/regenerate": {
      "post": {
        "summary": "Regenerate credential",
        "tags": [
          "Credentials"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "credentialId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "New credential created"
          }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "summary": "Get all services",
        "tags": [
