        }
      }
    },
    "/api/v1/services/create": {
      "post": {
        "summary": "Create new service",
        "tags": [
          "Services"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Service created"
          }
        }
      }
    },
    "/api/v1/services/health": {
      "get": {
        "summary": "Get system health",
        "tags": [
          "Services"
        ],
        "responses": {
          "200": {
            "description": "System health status"
          }
        }
      }
    },
