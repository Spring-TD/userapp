# Copy to .env locally. On Fly.io use: fly secrets set (see README Fly deployment).

MONGODB_URI=mongodb+srv://user:password@host/product_ms?tls=true

NODE_ENV=production
PORT=3005

# Comma-separated frontend origins allowed by CORS
CORS_ORIGINS=https://your-app.com,https://www.your-app.com

LOG_LEVEL=info

# client-auth-ms base URL (for JWT verify on loan workflow routes). Fallback: SERVICE_AUTH_URL.
CLIENT_AUTH_URL=http://localhost:3001

# Optional (if you wire these in code later)
# JWT_SECRET=
# DO_SPACES_REGION=
# DO_SPACES_ENDPOINT=
# DO_SPACES_BUCKET=
# DO_SPACES_ACCESS_KEY_ID=
# DO_SPACES_SECRET_ACCESS_KEY=
# DO_SPACES_CDN_URL=
