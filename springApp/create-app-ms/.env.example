# Server
NODE_ENV=development
PORT=4002

# MongoDB (DigitalOcean Managed Database)
# DigitalOcean example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/create_app_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# Local fallback:
# MONGODB_URI=mongodb://localhost:27017/create_app_db
MONGODB_URI=mongodb://localhost:27017/create_app_db

# Service URLs
SERVICE_AUTH_URL=http://localhost:4000
PRODUCT_SERVICE_URL=http://localhost:4005
WALLET_SERVICE_URL=http://localhost:4004

# Auth & keys
SPECIAL_API_KEY=your-special-api-key
PUBLIC_KEY=your-public-key
JWT_SECRET=your-jwt-secret

# Domain / subdomain
SUBDOMAIN_BASE_DOMAIN=springtd.com
PLATFORM_DOMAIN=domain.useinclude.com
SERVER_IP=

# Vercel (optional, for custom domains)
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
# VERCEL_DEFAULT_PROJECT_ID=
