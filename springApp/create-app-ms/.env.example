PORT=3002
MONGODB_URI=mongodb://localhost:27017/create-app-ms
JWT_SECRET=your-secret

# DigitalOcean Spaces (S3-compatible) — PWA template logo & splash uploads
# Region slug, e.g. nyc3, fra1, sgp1
DO_SPACES_REGION=
# Endpoint, e.g. https://nyc3.digitaloceanspaces.com
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
# Optional: CDN origin for public URLs, e.g. https://your-space.nyc3.cdn.digitaloceanspaces.com
DO_SPACES_CDN_URL=
# Object key prefix for uploads (no leading/trailing slashes)
DO_SPACES_PWA_PREFIX=pwa-assets

# Max image size for logo/splash uploads (MB)
PWA_ASSET_MAX_UPLOAD_MB=2

# Default app host: each app gets https://{subdomain}.{APP_PLATFORM_BASE_DOMAIN}
APP_PLATFORM_BASE_DOMAIN=springtd.com
APP_URL_SCHEME=https

# Optional: Vercel Domains API for custom hostnames (production); wire in your deployment.
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
