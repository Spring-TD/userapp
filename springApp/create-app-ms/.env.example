# =============================================================================
# Create App microservice — copy to .env and fill in real values.
# =============================================================================

NODE_ENV=development
PORT=3002

MONGODB_URI=mongodb://localhost:27017/create-app-ms
JWT_SECRET=your-secret

# Service auth (used where this service calls service-auth)
SERVICE_AUTH_URL=http://localhost:3000

# springApp local defaults: account-ms gateway, product-ms, wallet-ms
ACCOUNT_SERVICE_URL=http://localhost:4008
PRODUCT_SERVICE_URL=http://localhost:4005
WALLET_SERVICE_URL=http://localhost:3004

# ISO currency for new app-scoped TREASURY / OPERATION / KYC wallets (aligns with Payonus NUBAN defaults)
MERCHANT_WALLET_CURRENCY=NGN

# Special / integration API (X-Special-Key + X-Public-Key routes)
SPECIAL_API_KEY=default-special-key
PUBLIC_KEY=default-public-key

# DigitalOcean Spaces (S3-compatible) — PWA template logo & splash uploads
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_CDN_URL=
DO_SPACES_PWA_PREFIX=pwa-assets

PWA_ASSET_MAX_UPLOAD_MB=2

# Default app host: https://{APP_SUBDOMAIN_PREFIX}.{subdomain}.{APP_PLATFORM_BASE_DOMAIN}/
APP_PLATFORM_BASE_DOMAIN=tryspring.io
APP_SUBDOMAIN_PREFIX=www
APP_URL_SCHEME=https

# notifications-ms (email + in-app via POST .../send-dual)
NOTIFICATIONS_SERVICE_URL=http://localhost:4009

# Optional: Vercel Domains API for custom hostnames (production)
# VERCEL_API_TOKEN=
# VERCEL_TEAM_ID=
