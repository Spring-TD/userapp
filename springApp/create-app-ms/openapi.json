{
  "openapi": "3.0.0",
  "info": {
    "title": "Create App Microservice API",
    "version": "1.0.0",
    "description": "Application creation and management APIs"
  },
  "servers": [
    {
      "url": "http://localhost:3002",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "API key for service-to-service or special endpoints"
      }
    }
  },
  "paths": {
    "/api/v1/apps": {
      "get": {
        "summary": "Get all apps",
        "tags": [
          "Apps"
        ],
        "responses": {
          "200": {
            "description": "List of apps"
          }
        }
      },
      "post": {
        "summary": "Create a new app",
        "tags": [
          "Apps"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name",
                  "websiteUrl",
                  "alias",
                  "description"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "websiteUrl": {
                    "type": "string"
                  },
                  "alias": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "merchantId": {
                    "type": "string",
                    "description": "Optional; for admins. Merchants use their own ID from token."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "App created"
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/v1/apps/merchant/{merchantId}": {
      "get": {
        "summary": "Get apps by merchant ID",
        "tags": [
          "Apps"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "merchantId",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "List of apps for merchant"
          }
        }
      }
    },
    "/api/v1/apps/{id}": {
      "get": {
        "summary": "Get app by ID",
        "tags": [
          "Apps"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "App details"
          },
          "404": {
            "description": "App not found"
          }
        }
      },
      "put": {
        "summary": "Update app",
        "tags": [
          "Apps"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "websiteUrl": {
                    "type": "string"
                  },
                  "alias": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "draft",
                      "submitted",
                      "approved",
                      "rejected",
                      "incomplete"
                    ]
                  },
                  "rejectionReason": {
                    "type": "string"
                  },
                  "productKeys": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "App updated"
          }
        }
      },
      "delete": {
        "summary": "Delete app",
        "tags": [
          "Apps"
        ],
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "App deleted"
          }
        }
      }
    },
