{
  "openapi": "3.0.0",
  "info": {
    "title": "Create App Microservice API",
    "version": "1.0.0",
    "description": "Application creation and management, app configuration, drive, transactions, and special API (apps, products, wallets, users, subscriptions, callbacks). Import this spec into Swagger Editor, Postman, or other API tools."
  },
  "servers": [
    {
      "url": "http://localhost:4002",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-special-key",
        "description": "Special API key (use with x-public-key for special endpoints)"
      },
      "publicKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-public-key",
        "description": "Public key (use with x-special-key for special endpoints)"
      }
    },
    "schemas": {
      "CreateAppRequest": {
        "type": "object",
        "required": ["name", "websiteUrl", "alias", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 100 },
          "websiteUrl": { "type": "string", "format": "uri" },
          "alias": { "type": "string", "minLength": 2, "maxLength": 50 },
          "description": { "type": "string", "minLength": 10, "maxLength": 1000 },
          "merchantId": { "type": "string" },
          "subdomain": { "type": "string" }
        }
      },
      "UpdateAppRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "websiteUrl": { "type": "string" },
          "alias": { "type": "string" },
          "description": { "type": "string" },
          "status": { "type": "string", "enum": ["draft", "submitted", "approved", "rejected", "incomplete"] },
          "rejectionReason": { "type": "string" },
          "productKeys": { "type": "array", "items": { "type": "string" } },
          "subdomain": { "type": "string" },
          "customDomain": { "type": "string" },
          "customDomainActive": { "type": "boolean" }
        }
      },
      "RejectAppRequest": {
        "type": "object",
        "properties": {
          "rejectionReason": { "type": "string" }
        }
      },
      "AddProductKeyRequest": {
        "type": "object",
        "required": ["productKey"],
        "properties": {
          "productKey": { "type": "string" }
        }
      },
      "AddCustomDomainRequest": {
        "type": "object",
        "required": ["customDomain"],
        "properties": {
          "customDomain": { "type": "string" }
        }
      },
      "ActivateCustomDomainRequest": {
        "type": "object",
        "properties": {
          "active": { "type": "boolean" },
          "allowUnverified": { "type": "boolean" }
        }
      },
      "VerifyCustomDomainRequest": {
        "type": "object",
        "properties": {
          "manualOverride": { "type": "boolean" }
        }
      },
      "BulkUpdateAppsRequest": {
        "type": "object",
        "properties": {
          "updates": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "appId": { "type": "string" },
                "data": { "type": "object" }
              }
            }
          }
        }
      },
      "UploadDocumentRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "type": { "type": "string" },
          "url": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "UpdateDocumentRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "email": { "type": "string" },
          "name": { "type": "string" },
          "merchantId": { "type": "string" }
        }
      },
      "WithdrawRequest": {
        "type": "object",
        "required": ["amount"],
        "properties": {
          "amount": { "type": "number" },
          "description": { "type": "string" }
        }
      },
      "SubmitDocsRequest": {
        "type": "object",
        "properties": {
          "documents": { "type": "array", "items": { "type": "object" } }
        }
      },
      "SubscribeRequest": {
        "type": "object",
        "properties": {
          "subscriptionData": { "type": "object" }
        }
      },
      "ApplyToProductRequest": {
        "type": "object",
        "properties": {
          "applicationData": { "type": "object" }
        }
      },
      "RegisterCallbackRequest": {
        "type": "object",
        "required": ["eventType", "callbackUrl"],
        "properties": {
          "eventType": { "type": "string" },
          "callbackUrl": { "type": "string", "format": "uri" }
        }
      },
      "UpdateConfigurationRequest": {
        "type": "object",
        "description": "Partial configuration update"
      },
      "CreateConfigurationRequest": {
        "type": "object",
        "properties": {
          "configuration": { "type": "object" },
          "options": { "type": "object" }
        }
      },
      "PublishingRequest": {
        "type": "object",
        "properties": {
          "isPublished": { "type": "boolean" }
        }
      },
      "TemplateRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "config": { "type": "object" }
        }
      },
      "ApplyTemplateRequest": {
        "type": "object",
        "properties": {
          "options": { "type": "object" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/apps": {
      "post": {
        "summary": "Create app",
        "tags": ["Apps"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateAppRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "App created" },
          "400": { "description": "Validation error" }
        }
      },
      "get": {
        "summary": "Get all apps",
        "tags": ["Apps"],
        "responses": { "200": { "description": "App list" } }
      }
    },
    "/api/v1/apps/subdomain/{subdomain}": {
      "get": {
        "summary": "Get app by subdomain",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "subdomain", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "App details" } }
      }
    },
    "/api/v1/apps/{id}": {
      "get": {
        "summary": "Get app by ID",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "App details" } }
      },
      "put": {
        "summary": "Update app",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateAppRequest" }
            }
          }
        },
        "responses": { "200": { "description": "App updated" } }
      },
      "delete": {
        "summary": "Delete app",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "App deleted" } }
      }
    },
    "/api/v1/apps/merchant/{merchantId}": {
      "get": {
        "summary": "Get apps by merchant ID",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "merchantId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "App list" } }
      }
    },
    "/api/v1/apps/{id}/submit": {
      "post": {
        "summary": "Submit app for review",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "App submitted" } }
      }
    },
    "/api/v1/apps/{id}/approve": {
      "post": {
        "summary": "Approve app",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "App approved" } }
      }
    },
    "/api/v1/apps/{id}/reject": {
      "post": {
        "summary": "Reject app",
        "tags": ["Apps"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/RejectAppRequest" }
            }
          }
        },
        "responses": { "200": { "description": "App rejected" } }
      }
    },
    "/api/v1/apps/{id}/product-key": {
      "post": {
        "summary": "Add product key to app",
        "tags": ["Apps"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddProductKeyRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Product key added" } }
      }
    },
    "/api/v1/apps/{id}/product-keys": {
      "get": {
