# Server
NODE_ENV=development
PORT=4007

# MongoDB (use MONGODB_URI for Digital Ocean Managed MongoDB)
# DigitalOcean example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/payment_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# For Docker Compose, DATABASE_URL is often set by the stack:
# DATABASE_URL=mongodb://admin:adminpassword@mongodb:27017/payment_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017/payment_db

# Services
SERVICE_AUTH_URL=http://localhost:4000
BILLING_SERVICE_URL=http://localhost:4006
WALLET_SERVICE_URL=http://localhost:4004
# Shared secret for wallet-ms -> payment-ms internal ledger hooks
PAYMENT_INTERNAL_TOKEN=
CORS_ORIGINS=http://localhost:3000,http://localhost:4001

# JWT
JWT_SECRET=payment-jwt-secret-change-in-production

# Payment gateway (optional, for future gateway integration)
# PAYMENT_GATEWAY_API_KEY=
# PAYMENT_GATEWAY_SECRET=
# PAYMENT_GATEWAY_WEBHOOK_SECRET=

# Settlement wallet — transaction / airtime / utility fees (payment-ms → wallet-ms)
# PAYMENT_SETTLEMENT_ENABLED=false
DEFAULT_TRANSACTION_CHARGE_FIXED_NGN=50
# DEFAULT_TRANSACTION_CHARGE_PERCENT=0

# Optional
LOG_LEVEL=info
