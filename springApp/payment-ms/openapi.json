{
  "openapi": "3.0.0",
  "info": {
    "title": "Spring Payment Microservice API",
    "version": "1.0.0",
    "description": "Spring Payment processing (card, bank transfer, PayPal, crypto) and merchant record management with debit/credit ledger. Import this spec into Swagger Editor, Postman, or other API tools."
  },
  "servers": [
    {
      "url": "http://localhost:4007",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "ProcessPaymentRequest": {
        "type": "object",
        "required": ["amount", "method"],
        "properties": {
          "userId": { "type": "string", "description": "Optional if from JWT" },
          "amount": { "type": "number", "minimum": 0 },
          "currency": { "type": "string", "default": "USD" },
          "method": {
            "type": "string",
            "enum": ["card", "bank_transfer", "paypal", "crypto"]
          },
          "metadata": { "type": "object" }
        }
      },
      "CreateRecordWebhookRequest": {
        "type": "object",
        "required": ["userId", "email", "firstName", "lastName", "userType", "userMerchantId", "country", "verifiedAt"],
        "properties": {
          "userId": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "firstName": { "type": "string", "minLength": 1, "maxLength": 100 },
          "lastName": { "type": "string", "minLength": 1, "maxLength": 100 },
          "userType": { "type": "string", "enum": ["MERCHANT", "USER"] },
          "userMerchantId": { "type": "string", "minLength": 5, "maxLength": 50 },
          "country": { "type": "string", "minLength": 2, "maxLength": 100 },
          "phone": { "type": "string" },
          "verifiedAt": { "type": "string", "format": "date-time" },
          "metadata": { "type": "object" }
        }
      },
      "SenderInfo": {
        "type": "object",
        "required": ["full_name", "email", "phone"],
        "properties": {
          "full_name": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "FeeBreakdown": {
        "type": "object",
        "required": ["payout_fee", "merchant_commission"],
        "properties": {
          "payout_fee": { "type": "number" },
          "merchant_commission": { "type": "number" },
          "other_fee": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "amount": { "type": "number" }
              }
            }
          }
        }
      },
      "BeneficiaryInfo": {
        "type": "object",
        "properties": {
          "beneficiary_fiat_ref": { "type": "string" },
          "bank_name": { "type": "string" },
          "bank_code": { "type": "string" },
          "account_number": { "type": "string" },
          "account_holder_name": { "type": "string" },
          "other_data": { "type": "object" }
        }
      },
      "FundOrDebitRecordRequest": {
        "type": "object",
        "required": ["category", "amount", "description", "transactionType", "txnRef", "sessionId", "fromCurrency", "toCurrency", "senderInfo", "feeBreakdown"],
        "properties": {
          "category": {
            "type": "string",
            "enum": ["LOAN", "SAVINGS", "MORTGAGE", "COMMODITY", "WALLET"]
          },
          "amount": { "type": "number", "minimum": 0 },
          "description": { "type": "string" },
          "transactionType": {
            "type": "string",
            "enum": ["TRANSFER", "UTILITY_PAYMENT", "AIRTIME_PURCHASE", "BILL_PAYMENT", "MERCHANT_PAYMENT", "WITHDRAWAL", "DEPOSIT", "REFUND", "PAYOUT", "OTHER"]
          },
          "txnRef": { "type": "string" },
          "sessionId": { "type": "string" },
          "fromCurrency": { "type": "string" },
          "toCurrency": { "type": "string" },
          "senderInfo": { "$ref": "#/components/schemas/SenderInfo" },
          "feeBreakdown": { "$ref": "#/components/schemas/FeeBreakdown" },
          "thirdPartyRefId": { "type": "string" },
          "beneficiaryInfo": { "$ref": "#/components/schemas/BeneficiaryInfo" }
        }
      },
      "AddLedgerEntryRequest": {
        "type": "object",
        "required": ["entryType", "debitAmount", "transactionDescription", "transactionType", "txnRef", "sessionId", "fromCurrency", "toCurrency", "senderInfo", "feeBreakdown"],
        "properties": {
          "entryType": { "type": "string", "enum": ["DEBIT", "CREDIT"] },
          "debitAmount": { "type": "number" },
          "transactionDescription": { "type": "string" },
          "transactionType": {
            "type": "string",
            "enum": ["TRANSFER", "UTILITY_PAYMENT", "AIRTIME_PURCHASE", "BILL_PAYMENT", "MERCHANT_PAYMENT", "WITHDRAWAL", "DEPOSIT", "REFUND", "PAYOUT", "OTHER"]
          },
          "financialCategory": {
            "type": "string",
            "enum": ["LOAN", "SAVINGS", "MORTGAGE", "COMMODITY", "WALLET"]
          },
          "txnRef": { "type": "string" },
          "sessionId": { "type": "string" },
          "fromCurrency": { "type": "string" },
          "toCurrency": { "type": "string" },
          "senderInfo": { "$ref": "#/components/schemas/SenderInfo" },
          "feeBreakdown": { "$ref": "#/components/schemas/FeeBreakdown" },
          "thirdPartyRefId": { "type": "string" },
          "beneficiaryInfo": { "$ref": "#/components/schemas/BeneficiaryInfo" },
          "status": { "type": "string", "enum": ["PENDING", "COMPLETED", "FAILED", "REVERSED"] }
        }
      }
    }
  },
  "paths": {
    "/api/v1/payments/process": {
      "post": {
        "summary": "Process payment",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProcessPaymentRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Payment processed" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/payments/{paymentId}": {
      "get": {
        "summary": "Get payment by ID",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "paymentId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Payment details" },
          "404": { "description": "Payment not found" }
        }
      }
    },
    "/api/v1/payments/{paymentId}/refund": {
      "post": {
        "summary": "Refund payment",
        "tags": ["Payments"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "paymentId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Payment refunded" },
          "404": { "description": "Payment not found" }
        }
      }
    },
    "/api/v1/records/webhook/create": {
      "post": {
        "summary": "Create record (webhook from service-auth-ms)",
        "tags": ["Records"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateRecordWebhookRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Record created" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/api/v1/records/{recordId}": {
      "get": {
        "summary": "Get record by ID",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Record details" },
          "404": { "description": "Record not found" }
        }
      }
    },
    "/api/v1/records/user/{userId}": {
      "get": {
        "summary": "Get record by user ID",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Record details" },
          "404": { "description": "Record not found" }
        }
      }
    },
    "/api/v1/records/email/{email}": {
      "get": {
        "summary": "Get record by email",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "email", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Record details" },
          "404": { "description": "Record not found" }
        }
      }
    },
    "/api/v1/records/merchants/all": {
      "get": {
        "summary": "Get all merchant records",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Merchant records list" } }
      }
    },
    "/api/v1/records/merchant/{userMerchantId}/users": {
      "get": {
        "summary": "Get merchant-user records by merchant ID",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userMerchantId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "User records list" } }
      }
    },
    "/api/v1/records/{recordId}/ledger": {
      "get": {
        "summary": "Get ledger entries for record",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Ledger entries" } }
      }
    },
    "/api/v1/records/{recordId}/ledger/summary": {
      "get": {
        "summary": "Get ledger summary",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Ledger summary" } }
      }
    },
    "/api/v1/records/{recordId}/ledger/entry": {
      "post": {
        "summary": "Add ledger entry",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AddLedgerEntryRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Ledger entry added" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/records/{recordId}/deactivate": {
      "put": {
        "summary": "Deactivate record",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Record deactivated" },
          "404": { "description": "Record not found" }
        }
      }
    },
    "/api/v1/records/{recordId}/activate": {
      "put": {
        "summary": "Activate record",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Record activated" },
          "404": { "description": "Record not found" }
        }
      }
    },
    "/api/v1/records/{recordId}/fund": {
      "post": {
        "summary": "Fund record (credit)",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FundOrDebitRecordRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Record funded" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/records/{recordId}/debit": {
      "post": {
        "summary": "Debit record",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/FundOrDebitRecordRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Record debited" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/records/{recordId}/category-summary": {
      "get": {
        "summary": "Get category-specific summary",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Category summary" } }
      }
    },
    "/api/v1/records/{recordId}/analytics": {
      "get": {
        "summary": "Get record analytics",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "recordId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Analytics" } }
      }
    },
    "/api/v1/records/merchant/{userMerchantId}/analytics": {
      "get": {
        "summary": "Get aggregated merchant analytics",
        "tags": ["Records"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userMerchantId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Merchant analytics" } }
      }
    }
  },
  "tags": [
    { "name": "Payments", "description": "Process payment, get payment, refund" },
    { "name": "Records", "description": "Merchant records, ledger, fund/debit, analytics" }
  ]
}
