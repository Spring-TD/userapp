NODE_ENV=development
PORT=4008
MONGO_URI=mongodb://localhost:27017/account_db
# Extra origins (comma-separated). Tenant PWAs on *.tryspring.io are allowed automatically via PLATFORM_BASE_DOMAIN.
CORS_ORIGINS=http://localhost:4000,http://localhost:4001
LOG_LEVEL=info

# Rate limiting (public edge). Window defaults to 15 minutes.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=2000
AUTH_RATE_LIMIT_MAX_REQUESTS=20

# Host-based tenant resolution for www.{subdomain}.tryspring.io
PLATFORM_BASE_DOMAIN=tryspring.io
PLATFORM_SUBDOMAIN_PREFIX=www
RESERVED_SUBDOMAINS=www,api,admin,docs
# Allow time for create-app-ms (e.g. Fly cold start + network); default 30s
TENANT_RESOLVER_TIMEOUT_MS=30000

CREATE_APP_SERVICE_URL=https://create-app-ms.fly.dev
WALLET_SERVICE_URL=https://wallet-ms.fly.dev
JWT_SECRET=shared-jwt-secret

# Commodity purchase — Plata gateway (same keys as product-ms catalog)
PLATA_ACCOUNT_SERVICE_URL=https://account-ms-plata.fly.dev
PLATA_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PLATA_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxx

# Inbound Plata integrator applicant-profile pulls (verify keys against Plata service-auth)
PLATA_SERVICE_AUTH_URL=https://service-auth-ms-plata.fly.dev
# Must match service-auth-ms-plata JWT_SECRET (not Spring service-auth JWT_SECRET)
PLATA_SERVICE_AUTH_INTERNAL_TOKEN=