        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "documentId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Document details" } }
      },
      "put": {
        "summary": "Update document status",
        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "documentId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateDocumentStatusRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Status updated" } }
      }
    },
    "/api/v1/kyc/review/{kycId}": {
      "post": {
        "summary": "Review KYC submission",
        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "kycId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ReviewKYCRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Review completed" } }
      }
    },
    "/api/v1/kyc/search": {
      "get": {
        "summary": "Search KYC profiles",
        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "q", "schema": { "type": "string" } },
          { "in": "query", "name": "status", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Search results" } }
      }
    },
    "/api/v1/kyc/business/{merchantId}/shareholders/create": {
