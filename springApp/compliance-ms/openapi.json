{
  "openapi": "3.0.0",
  "info": {
    "title": "Compliance (KYC) Microservice API",
    "version": "1.0.0",
    "description": "KYC verification, AML checks, sanctions screening, document verification, individual and business compliance. Import this spec into Swagger Editor, Postman, or other API tools."
  },
  "servers": [
    {
      "url": "http://localhost:3003",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      },
      "serviceAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "Authorization",
        "description": "Service-to-service Bearer token"
      }
    },
    "schemas": {
      "SubmitIndividualKYCRequest": {
        "type": "object",
        "description": "Individual KYC submission payload",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string", "format": "email" },
          "phone": { "type": "string" },
          "dateOfBirth": { "type": "string", "format": "date" },
          "address": { "type": "object" },
          "documents": { "type": "array", "items": { "type": "object" } }
        }
      },
      "SubmitBusinessKYCRequest": {
        "type": "object",
        "description": "Business KYC submission payload",
        "properties": {
          "businessName": { "type": "string" },
          "businessType": { "type": "string" },
          "registrationNumber": { "type": "string" },
          "country": { "type": "string" },
          "documents": { "type": "array", "items": { "type": "object" } }
        }
      },
      "UpdatePersonalInfoRequest": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "phone": { "type": "string" },
          "address": { "type": "object" }
        }
      },
      "UpdateBusinessInfoRequest": {
        "type": "object",
        "properties": {
          "businessName": { "type": "string" },
          "registrationNumber": { "type": "string" },
          "country": { "type": "string" }
        }
      },
      "UpdateBusinessSurveyRequest": {
        "type": "object",
        "properties": {
          "surveyData": { "type": "object" }
        }
      },
      "UpdateBeneficialOwnersRequest": {
        "type": "object",
        "properties": {
          "beneficialOwners": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "ownershipPercentage": { "type": "number" },
                "country": { "type": "string" }
              }
            }
          }
        }
      },
      "UpdateRiskLevelRequest": {
        "type": "object",
        "properties": {
          "riskLevel": { "type": "string", "enum": ["low", "medium", "high"] },
          "notes": { "type": "string" }
        }
      },
      "ReviewKYCRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["approved", "rejected"] },
          "rejectionReason": { "type": "string" },
          "notes": { "type": "string" }
        }
      },
      "UpdateDocumentStatusRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string" },
          "note": { "type": "string" }
        }
      },
      "SendMessageRequest": {
        "type": "object",
        "properties": {
          "message": { "type": "string" }
        }
      },
      "BlockUserRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string" }
        }
      },
      "CheckSanctionsRequest": {
        "type": "object",
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "maxLength": 255 },
          "companyId": { "type": "string", "maxLength": 100 },
          "country": { "type": "string", "minLength": 2, "maxLength": 2, "description": "ISO 2-letter country code" }
        }
      },
      "VerifyCertificateRequest": {
        "type": "object",
        "properties": {
          "registrationNumber": { "type": "string" },
          "companyName": { "type": "string" }
        }
      },
      "UpdateWorkflowStatusRequest": {
        "type": "object",
        "properties": {
          "workflowStatus": { "type": "string" },
          "notes": { "type": "string" }
        }
      },
      "CreateShareholderRequest": {
        "type": "object",
        "properties": {
          "shareholders": { "type": "array", "items": { "type": "object" } }
        }
      },
      "LivenessWebhookRequest": {
        "type": "object",
        "description": "Webhook payload from liveness provider",
        "properties": {
          "providerReference": { "type": "string" },
          "status": { "type": "string" },
          "result": { "type": "object" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/kyc/submit": {
      "post": {
        "summary": "Submit KYC (legacy)",
        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "type": "object", "description": "KYC submission data" }
            }
          }
        },
        "responses": { "200": { "description": "KYC submitted" } }
      }
    },
    "/api/v1/kyc/status/{userId}": {
      "get": {
        "summary": "Get KYC status by user (legacy)",
        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "KYC status" } }
      }
    },
    "/api/v1/kyc/profile/{userId}": {
      "post": {
        "summary": "Create minimal KYC profile",
        "tags": ["KYC - Legacy"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Profile created" } }
      }
    },
    "/api/v1/kyc/documents/{userId}": {
      "get": {
        "summary": "Get all KYC documents (legacy)",
        "tags": ["KYC - Legacy"],
