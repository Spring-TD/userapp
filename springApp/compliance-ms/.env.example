# Server
NODE_ENV=development
PORT=3003

# MongoDB (use MONGODB_URI for DigitalOcean Managed MongoDB)
# DigitalOcean example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/compliance_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# For Docker Compose, MONGODB_URI is set in the stack. Fallback:
# DATABASE_URL=mongodb://admin:adminpassword@mongodb:27017/compliance_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017/compliance_db

# Auth & CORS
JWT_SECRET=your-jwt-secret-change-in-production
# Optional override when client-auth-ms signs user JWTs with a different secret.
# If omitted, compliance-ms will fall back to JWT_SECRET for client-auth-ms tokens too.
# CLIENT_AUTH_JWT_SECRET=your-client-auth-jwt-secret
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# KYC (required - see README for full list)
KYC_DOCUMENT_TYPES=identity,address,income_proof,bank,business_registration,business_license,corporate_structure,beneficial_ownership,articles_of_incorporation,director_identification,financial_statements,tax_certificate
KYC_REQUIRED_DOCUMENTS=identity,address,business_registration,beneficial_ownership,director_identification,bank
KYC_REVIEW_DURATION=72
KYC_NOTIFICATIONS_ENABLED=false
KYC_NOTIFICATIONS_CHANNELS=email,sms
KYC_MAX_DOCUMENT_SIZE=10
KYC_MAX_DOCUMENTS=5
KYC_AUTO_APPROVAL_LIMIT=5000
KYC_REVIEW_TIMEOUT=30000
KYC_REVIEW_RETRIES=3
KYC_REVIEW_RETRY_DELAY=5000
KYC_REVIEW_NOTIFICATIONS=false
KYC_REVIEW_NOTIFICATIONS_CHANNELS=email
KYC_REVIEW_NOTIFICATIONS_TEMPLATES=verification
KYC_REVIEW_NOTIFICATIONS_RECIPIENTS=admin
KYC_REVIEW_NOTIFICATIONS_RETRIES=3
KYC_REVIEW_NOTIFICATIONS_RETRY_DELAY=5000
KYC_REVIEW_NOTIFICATIONS_TIMEOUT=30000
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_PATH=./templates
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_EXTENSION=.hbs
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_ENCODING=utf8
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_DELIMITER="{{}}"
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_DELIMITER_START="{{"
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_DELIMITER_END="}}"
KYC_REVIEW_NOTIFICATIONS_TEMPLATE_DELIMITER_ESCAPE=\\

# DigitalOcean Spaces (for document uploads)
# Example values:
# DO_SPACES_REGION=nyc3
# DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
# DO_SPACES_BUCKET=springtd-compliance-documents
# DO_SPACES_ACCESS_KEY_ID=your-access-key
# DO_SPACES_SECRET_ACCESS_KEY=your-secret-key
# Optional CDN/custom domain:
# DO_SPACES_CDN_URL=https://springtd-compliance-documents.nyc3.cdn.digitaloceanspaces.com
DO_SPACES_REGION=
DO_SPACES_ENDPOINT=
DO_SPACES_BUCKET=
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
DO_SPACES_CDN_URL=

# Optional: Redis, Prembly, CAC, OpenSanctions
# REDIS_URL=
# PREMBLY_API_KEY=
# PREMBLY_API_SECRET=
# CAC_API_URL=
# OPENSANCTIONS_API_KEY=
