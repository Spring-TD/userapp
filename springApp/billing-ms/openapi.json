{
  "openapi": "3.0.0",
  "info": {
    "title": "Spring Billing Microservice API",
    "version": "1.0.0",
    "description": "Spring Billing, invoicing, payment processing, subscriptions, recurring billing, and pricing APIs. Import this spec into Swagger Editor, Postman, or other API tools."
  },
  "servers": [
    {
      "url": "http://localhost:4006",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "InvoiceItem": {
        "type": "object",
        "required": ["id", "description", "quantity", "unitPrice", "total"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string" },
          "quantity": { "type": "number" },
          "unitPrice": { "type": "number" },
          "total": { "type": "number" }
        }
      },
      "CreateInvoiceRequest": {
        "type": "object",
        "required": ["merchantId", "amount", "currency", "billingType"],
        "properties": {
          "merchantId": { "type": "string" },
          "customerId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string", "default": "USD" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/InvoiceItem" } },
          "billingType": { "type": "string", "enum": ["one_time", "recurring"] },
          "status": { "type": "string", "enum": ["draft", "pending", "paid", "overdue", "cancelled"] },
          "dueDate": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      },
      "UpdateInvoiceRequest": {
        "type": "object",
        "properties": {
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "items": { "type": "array", "items": { "$ref": "#/components/schemas/InvoiceItem" } },
          "status": { "type": "string", "enum": ["draft", "pending", "paid", "overdue", "cancelled"] },
          "dueDate": { "type": "string", "format": "date-time" },
          "notes": { "type": "string" }
        }
      },
      "ProcessPaymentRequest": {
        "type": "object",
        "required": ["invoiceId", "amount", "currency"],
        "properties": {
          "invoiceId": { "type": "string" },
          "merchantId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "paymentMethod": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "CreateSubscriptionRequest": {
        "type": "object",
        "required": ["merchantId", "planId", "billingCycle"],
        "properties": {
          "merchantId": { "type": "string" },
          "planId": { "type": "string" },
          "billingCycle": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "UpdateSubscriptionRequest": {
        "type": "object",
        "properties": {
          "planId": { "type": "string" },
          "billingCycle": { "type": "string" },
          "amount": { "type": "number" },
          "status": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "CheckBillingStatusRequest": {
        "type": "object",
        "required": ["userId", "amount"],
        "properties": {
          "userId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "RecurringBillingRequest": {
        "type": "object",
        "required": ["billingType", "billingCycle", "billingFor", "billingTitle"],
        "properties": {
          "billingType": { "type": "string", "enum": ["recurring", "one_time"] },
          "billingCycle": { "type": "number" },
          "billingTarget": { "type": "number" },
          "billingCount": { "type": "number" },
          "billToType": { "type": "string", "enum": ["merchants", "users"] },
          "billingFor": { "type": "string" },
          "billingTitle": { "type": "string" },
          "billingException": {
            "type": "object",
            "properties": {
              "maxAttempts": { "type": "number" },
              "currentAttempts": { "type": "number" }
            }
          }
        }
      },
      "UpdateRecurringBillingRequest": {
        "type": "object",
        "properties": {
          "billingCycle": { "type": "number" },
          "billingTarget": { "type": "number" },
          "billingTitle": { "type": "string" },
          "billingFor": { "type": "string" }
        }
      },
      "OneTimeBillingRequest": {
        "type": "object",
        "required": ["merchantId", "amount", "currency"],
        "properties": {
          "merchantId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "description": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "TransferRequest": {
        "type": "object",
        "required": ["fromUserId", "toUserId", "amount", "currency"],
        "properties": {
          "fromUserId": { "type": "string" },
          "toUserId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "WithdrawalRequest": {
        "type": "object",
        "required": ["userId", "amount", "currency"],
        "properties": {
          "userId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "PayoutRequest": {
        "type": "object",
        "required": ["merchantId", "amount", "currency"],
        "properties": {
          "merchantId": { "type": "string" },
          "amount": { "type": "number" },
          "currency": { "type": "string" },
          "description": { "type": "string" }
        }
      },
      "PricingScheduleRequest": {
        "type": "object",
        "properties": {
          "name": { "type": "string" },
          "conditions": { "type": "object" },
          "billToType": { "type": "string" },
          "billingCycle": { "type": "number" },
          "amount": { "type": "number" },
          "currency": { "type": "string" }
        }
      },
      "ProductCreatedTriggerRequest": {
        "type": "object",
        "properties": {
          "productId": { "type": "string" },
          "merchantId": { "type": "string" },
          "metadata": { "type": "object" }
        }
      },
      "WalletFundedTriggerRequest": {
        "type": "object",
        "properties": {
          "userId": { "type": "string" },
          "amount": { "type": "number" },
          "walletId": { "type": "string" }
        }
      },
      "MerchantUsersCountTriggerRequest": {
        "type": "object",
        "properties": {
          "merchantId": { "type": "string" },
          "usersCount": { "type": "number" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/billing/invoices": {
      "post": {
        "summary": "Create invoice",
        "tags": ["Billing - Invoices"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateInvoiceRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Invoice created" },
          "400": { "description": "Bad request" }
        }
      },
      "get": {
        "summary": "List invoices",
        "tags": ["Billing - Invoices"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [
          { "in": "query", "name": "merchantId", "schema": { "type": "string" } },
          { "in": "query", "name": "status", "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Invoice list" } }
      }
    },
    "/api/v1/billing/invoices/{id}": {
      "get": {
        "summary": "Get invoice by ID",
        "tags": ["Billing - Invoices"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Invoice details" } }
      },
      "put": {
        "summary": "Update invoice",
        "tags": ["Billing - Invoices"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateInvoiceRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Invoice updated" } }
      },
      "delete": {
        "summary": "Delete invoice",
        "tags": ["Billing - Invoices"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Invoice deleted" } }
      }
    },
    "/api/v1/billing/payments": {
