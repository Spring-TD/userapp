# Server
NODE_ENV=development
PORT=3006

# MongoDB (use MONGODB_URI for DigitalOcean Managed MongoDB)
# DigitalOcean example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/billing_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# For local Docker Compose, docker-compose sets DATABASE_URL:
# DATABASE_URL=mongodb://admin:adminpassword@mongodb:27017/billing_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017/billing_db

# Services
SERVICE_AUTH_URL=http://localhost:3000
WALLET_SERVICE_URL=http://localhost:4004
CREATE_APP_SERVICE_URL=http://localhost:3002
CLIENT_AUTH_SERVICE_URL=http://localhost:3001
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth (shared JWT_SECRET — sent as X-Internal-Token to wallet-ms, create-app-ms, client-auth-ms)
JWT_SECRET=your-jwt-secret-change-in-production

# Schedulers (milliseconds)
RECURRING_BILLING_INTERVAL=3600000
PRICING_INTERVAL=3600000
MERCHANT_MONTHLY_BILLING_INTERVAL=3600000

# Merchant monthly Billing-wallet fee: price per registered retail customer (per app, per month)
BILLING_PRICE_PER_CUSTOMER=100
# UTC day of month to run billing (1–28, default 1)
MERCHANT_MONTHLY_BILLING_DAY=1
# MERCHANT_MONTHLY_BILLING_ENABLED=false

# Account maintenance — monthly fee per retail customer (user PRIMARY → merchant SETTLEMENT)
ACCOUNT_MAINTENANCE_FEE_NGN=100
# ACCOUNT_MAINTENANCE_BILLING_DAY=1
# ACCOUNT_MAINTENANCE_INTERVAL=3600000
# ACCOUNT_MAINTENANCE_SETTLEMENT_ENABLED=false

# Logging
LOG_LEVEL=info
