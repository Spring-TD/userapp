# Server
NODE_ENV=development
PORT=3006

# MongoDB (use MONGODB_URI for DigitalOcean Managed MongoDB)
# DigitalOcean example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/billing_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# For local Docker Compose, docker-compose sets DATABASE_URL:
# DATABASE_URL=mongodb://admin:adminpassword@mongodb:27017/billing_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017/billing_db

# Services
SERVICE_AUTH_URL=http://localhost:3000
WALLET_SERVICE_URL=http://localhost:3004
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Auth
JWT_SECRET=your-jwt-secret-change-in-production

# Schedulers (milliseconds)
RECURRING_BILLING_INTERVAL=3600000
PRICING_INTERVAL=3600000

# Logging
LOG_LEVEL=info
