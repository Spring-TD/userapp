# Server
NODE_ENV=development
PORT=4009

# MongoDB (Digital Ocean Managed Database)
# Use your Digital Ocean MongoDB connection string. Example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/notifications_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# Alternative env names (all supported): MONGO_URI, MONGODB_URI, DATABASE_URL
# MONGODB_URI=

# Local fallback (comment out when using Digital Ocean):
MONGO_URI=mongodb://localhost:27017/notifications_db

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:4008

# Mailtrap SMTP (Email)
MAILTRAP_HOST=smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USER=
MAILTRAP_PASSWORD=
MAILTRAP_FROM_EMAIL=noreply@springtd.com

# Twilio (SMS - Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Logging
LOG_LEVEL=info
