PORT=4009
MONGODB_URI=mongodb://localhost:27017/notifications_db
CORS_ORIGINS=http://localhost:3000

# Email (Mailtrap)
MAILTRAP_API_TOKEN=
MAILTRAP_USER=
MAILTRAP_PASSWORD=
MAILTRAP_FROM_EMAIL=noreply@springtd.com
MAILTRAP_FROM_NAME=SpringTD

# SMS (Twilio) — optional
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Web Push (VAPID) — optional; generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@springtd.com

# Inbox auth — must match client-auth-ms JWT_SECRET
JWT_SECRET=
