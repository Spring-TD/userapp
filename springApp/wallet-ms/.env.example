NODE_ENV=development
PORT=4004
FRONTEND_URL=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:4000
COMPLIANCE_SERVICE_URL=http://localhost:4003
JWT_SECRET=wallet-service-secret-key
JWT_EXPIRES_IN=1h

# Database - MongoDB (DigitalOcean or local)
# DigitalOcean: use connection string from Managed MongoDB cluster
# Local: mongodb://localhost:27017/wallet_ms
MONGODB_URI=mongodb+srv://user:password@host/database?tls=true&authSource=admin
