NODE_ENV=development
PORT=4004
FRONTEND_URL=http://localhost:3000
CLIENT_AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:4000
COMPLIANCE_SERVICE_URL=http://localhost:4003
JWT_SECRET=wallet-service-secret-key
JWT_EXPIRES_IN=1h
REQUEST_BODY_LIMIT=10mb
MONGODB_URI=mongodb://localhost:27017/wallet_ms

# Same value as client-auth-ms WALLET_INTERNAL_TOKEN (signup → internal wallet create)
WALLET_INTERNAL_TOKEN=

PAYONUS_NUBAN_ENABLED=true
PAYONUS_BASE_URL=https://core.payonus.com
PAYONUS_AUTH_MODE=oauth
PAYONUS_CLIENT_ID=
PAYONUS_CLIENT_SECRET=
PAYONUS_NUBAN_CURRENCIES=NGN

PAYONUS_VA_BUSINESS_ID=
PAYONUS_VA_DOB=1990-01-01
PAYONUS_VA_NOTIFICATION_URL=https://your-domain.com/webhooks/payonus
# Example when webhooks go through account-ms gateway: https://account-ms.fly.dev/api/v1/wallets/funding/callback
