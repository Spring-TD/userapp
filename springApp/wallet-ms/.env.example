NODE_ENV=development
PORT=4004
FRONTEND_URL=http://localhost:3000
CLIENT_AUTH_SERVICE_URL=http://localhost:3001
AUTH_SERVICE_URL=http://localhost:4000
COMPLIANCE_SERVICE_URL=http://localhost:4003
# Same value as compliance-ms COMPLIANCE_WALLET_INTERNAL_TOKEN (sent as X-Internal-Token for BVN lookup).
COMPLIANCE_WALLET_INTERNAL_TOKEN=
# Optional: wallet-ms -> payment-ms ledger hook after successful payouts.
PAYMENT_SERVICE_URL=http://localhost:4007
PAYMENT_INTERNAL_TOKEN=
# Optional: mirror successful PayOnUs wallet funding into create-app-ms app transaction table.
CREATE_APP_SERVICE_URL=http://localhost:3002
# product-ms — loan charge on product wallet → PRIMARY transfer (no-equity loans).
PRODUCT_SERVICE_URL=http://localhost:4002
JWT_SECRET=wallet-service-secret-key
JWT_EXPIRES_IN=1h
REQUEST_BODY_LIMIT=10mb
MONGODB_URI=mongodb://localhost:27017/wallet_ms

# Same value as client-auth-ms WALLET_INTERNAL_TOKEN (signup → internal wallet create)
WALLET_INTERNAL_TOKEN=

PAYONUS_NUBAN_ENABLED=true
PAYONUS_BASE_URL=https://core.payonus.com
PAYONUS_AUTH_MODE=oauth
PAYONUS_CLIENT_ID=
PAYONUS_CLIENT_SECRET=
PAYONUS_NUBAN_CURRENCIES=NGN

# --- LegerBlock (PayOnUs replacement; dual-run with existing PayOnUs NUBANs) ---
# Docs: https://docs.legerblock.com  |  Remember: .cursor/remember/legerblock-payonus-replacement.md
# Set NUBAN_PROVIDER_DEFAULT=legerblock only after credentials + IP whitelist are ready.
NUBAN_PROVIDER_DEFAULT=payonus
LEGERBLOCK_NUBAN_ENABLED=false
LEGERBLOCK_BASE_URL=https://block.fuspay.finance
LEGERBLOCK_API_KEY=
LEGERBLOCK_MERCHANT_REF=
# Optional dedicated bank-list key (falls back to LEGERBLOCK_API_KEY)
# LEGERBLOCK_BANK_LIST_API_KEY=
LEGERBLOCK_WEBHOOK_SECRET=
LEGERBLOCK_WEBHOOK_ENFORCE_SIGNATURE=false
LEGERBLOCK_COLLECTION_NOTIFICATION_URL=https://your-gateway/api/v1/wallets/funding/callback/legerblock
LEGERBLOCK_PAYOUT_NOTIFICATION_URL=https://your-gateway/api/v1/wallets/payout/callback/legerblock
# Required to confirm wallet→bank payouts (LegerBlock PIN confirm step)
LEGERBLOCK_WALLET_PIN=
# LEGERBLOCK_VA_BVN=
# LEGERBLOCK_VA_USE_TEST_PLACEHOLDERS=true

PAYONUS_VA_BUSINESS_ID=
PAYONUS_VA_DOB=1990-01-01
PAYONUS_VA_NOTIFICATION_URL=https://your-domain.com/webhooks/payonus

# --- Bank payout / disbursement (user + settlement wallet "send to bank") ---
# Implements PayOnUs Bank Transfer: name-enquiry (verify account) then bank-transfer.
# Docs: https://documentation.payonus.com/payouts/transfers/
# Dashboard prerequisites: (1) whitelist wallet-ms outbound IP(s); (2) fund the
# PayOnUs business wallet. PAYONUS_VA_BUSINESS_ID (above) is used as businessId.
PAYONUS_PAYOUT_PATH=/api/v1/transfer-requests/bank-transfer
PAYONUS_NAME_ENQUIRY_PATH=/api/v1/transfer-requests/name-enquiry
PAYONUS_NAME_ENQUIRY_ENABLED=true
PAYONUS_PAYOUT_TRANSFER_TYPE=WALLET_TO_BANK_ACCOUNT
PAYONUS_PAYOUT_COUNTRY_CODE=NG
# PayOnUs bank-transfer body requires an email; used when the caller has none.
PAYONUS_PAYOUT_DEFAULT_EMAIL=
# In-process cache TTL (ms) for GET /api/v1/wallets/banks. Default 21600000 (6 hours).
PAYONUS_BANK_LIST_CACHE_TTL_MS=21600000
# notificationUrl PayOnUs calls back with the final payout status. Point it at the payout
# webhook so failed/reversed payouts auto-refund the wallet. Defaults to PAYONUS_VA_NOTIFICATION_URL
# (the funding handler still detects + routes payout callbacks that land there).
# PAYONUS_PAYOUT_NOTIFICATION_URL=https://account-ms.fly.dev/api/v1/wallets/payout/callback
# Optional extra static fields merged into the transfer body.
# PAYONUS_PAYOUT_EXTRA_JSON={"channel":"BANK_TRANSFER"}
# Advanced overrides (rarely needed):
# PAYONUS_PAYOUT_METHOD=POST
# PAYONUS_PAYOUT_BODY_JSON={...}   # replaces built-in body; supports {{placeholder}} substitution
# PAYONUS_PAYOUT_RESPONSE_REFERENCE_PATHS=data.onusReference,onusReference
# PAYONUS_PAYOUT_RESPONSE_STATUS_PATHS=data.paymentStatus,paymentStatus
# Example when webhooks go through account-ms gateway: https://account-ms.fly.dev/api/v1/wallets/funding/callback
# Must match the verification key configured in the PayOnUs dashboard.
PAYONUS_WEBHOOK_VERIFICATION_KEY=
PAYONUS_WEBHOOK_ENFORCE_SIGNATURE=false
