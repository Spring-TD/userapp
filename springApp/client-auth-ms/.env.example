# Server
NODE_ENV=development
PORT=3001

# MongoDB (use MONGODB_URI for DigitalOcean Managed MongoDB)
# DigitalOcean example:
# MONGODB_URI="mongodb+srv://doadmin:YOUR_PASSWORD@db-mongodb-YOUR_CLUSTER.mongo.ondigitalocean.com/client_auth_db?tls=true&authSource=admin&replicaSet=db-mongodb"
#
# For Docker Compose, DATABASE_URL is often set by the stack:
# DATABASE_URL=mongodb://admin:adminpassword@mongodb:27017/client_auth_db?authSource=admin
MONGODB_URI=mongodb://localhost:27017/client_auth_db

# Services
SERVICE_AUTH_URL=http://localhost:3000
# Notifications: must match where notifications-ms is reachable.
# - Local `npm run dev` in notifications-ms defaults to PORT 4009 → http://localhost:4009
# - Docker Compose maps notifications-ms to host :3009 → http://localhost:3009 from the host
# - Compose sets NOTIFICATIONS_SERVICE_URL for client-auth-ms to http://notifications-ms:3009 automatically
# - Fly.io: public HTTPS base (your app hostname from the dashboard), e.g. https://springtd-notifications-ms.fly.dev
#   Same-org private: http://<notifications-app-name>.internal:3009 (see notifications-ms/fly.toml internal_port)
NOTIFICATIONS_SERVICE_URL=http://localhost:4009
COMPLIANCE_SERVICE_URL=http://localhost:3003
CREATE_APP_SERVICE_URL=http://localhost:4002
PLATFORM_BASE_DOMAIN=tryspring.io
PLATFORM_SUBDOMAIN_PREFIX=www
RESERVED_SUBDOMAINS=www,api,admin,docs
TENANT_RESOLVER_TIMEOUT_MS=30000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# wallet-ms: provision Payonus-backed user wallet after POST /api/v1/registration/user
# Base URL of wallet-ms only (no /api/v1 path). Example: http://localhost:4004 or https://your-wallet-ms.fly.dev
# Must match wallet-ms WALLET_INTERNAL_TOKEN. If either is unset, signup skips wallet creation.
WALLET_SERVICE_URL=http://localhost:4004
WALLET_INTERNAL_TOKEN=
# product-ms and other trusted services use this for GET /api/v1/user/internal/phone/:userId
CLIENT_AUTH_INTERNAL_TOKEN=
USER_WALLET_DEFAULT_CURRENCY=NGN
# WALLET_SERVICE_HTTP_TIMEOUT_MS=30000

# JWT
# Must match compliance-ms JWT_SECRET so client-auth can sign service JWT for profile bootstrap calls.
JWT_SECRET=your-jwt-secret-change-in-production
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_ROUNDS=12

# Optional
LOG_LEVEL=info
FRONTEND_URL=http://localhost:3000

# DigitalOcean Spaces profile picture uploads
DO_SPACES_REGION=nyc3
DO_SPACES_ENDPOINT=https://nyc3.digitaloceanspaces.com
DO_SPACES_BUCKET=your-space-name
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=
# Optional CDN/custom domain base URL. When unset, the public Spaces URL is returned.
DO_SPACES_CDN_URL=
CLIENT_AUTH_PROFILE_PICTURE_PREFIX=profile-pictures
# Max image size in MB.
CLIENT_AUTH_PROFILE_PICTURE_MAX_SIZE=5

# Fuspay Modular KYC (create user on signup)
# When enabled, signup sends branding from the tenant PWA manifest (CREATE_APP_SERVICE_URL).
# FUSPAY_MODULAR_KYC_ENABLED=false
# FUSPAY_MODULAR_BASE_URL=https://kyc-verif-new.fly.dev
# FUSPAY_MODULAR_APP_ID=
# FUSPAY_MODULAR_API_KEY=
# Comma-separated ISO alpha-2 codes sent to Fuspay (default NG,TZ,GH,KE)
# FUSPAY_MODULAR_ALLOWED_COUNTRIES=NG,TZ,GH,KE
