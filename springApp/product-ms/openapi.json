{
  "openapi": "3.0.0",
  "info": {
    "title": "Spring Product Microservice API",
    "version": "1.0.0",
    "description": "Spring Product management (Loan, Mortgage, Savings, Commodity) and product configuration. Import this spec into Swagger Editor, Postman, or other API tools."
  },
  "servers": [
    {
      "url": "http://localhost:4005",
      "description": "Development"
    }
  ],
  "components": {
    "schemas": {
      "ToggleActivationRequest": {
        "type": "object",
        "required": ["activate"],
        "properties": {
          "activate": { "type": "boolean", "description": "True to activate, false to deactivate" }
        }
      },
      "MerchantProductConfigRequest": {
        "type": "object",
        "description": "Merchant-specific product configuration (pricing, caps, fees)",
        "properties": {
          "pricingType": { "type": "string", "enum": ["percent", "Fixed pricing"] },
          "pricingCondition": { "type": "string", "enum": ["With cap", "No Cap"] },
          "upperCap": { "type": "number" },
          "lowerCap": { "type": "number" },
          "springTDFee": { "type": "number" },
          "serviceFee": { "type": "number" },
          "markupRate": { "type": "number" },
          "customTerms": { "type": "object" },
          "enabledFeatures": { "type": "array", "items": { "type": "string" } }
        }
      },
      "UpdateProductManageRequest": {
        "type": "object",
        "description": "Product management update (name, description, type, status, type-specific fields)",
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 },
          "type": { "type": "string", "enum": ["Loan", "Mortgage", "Savings", "Commodity"] },
          "status": { "type": "string", "enum": ["complete", "incomplete"] },
          "equityContribution": { "type": "number" },
          "propertyValue": { "type": "number" },
          "price": { "type": "number" },
          "minimumQuantity": { "type": "number" },
          "unitOfMeasure": { "type": "string" }
        }
      },
      "CreateProductConfigurationRequest": {
        "type": "object",
        "required": ["productId", "productType"],
        "properties": {
          "productId": { "type": "string" },
          "productType": { "type": "string", "description": "Loan, Mortgage, Savings, or Commodity" },
          "configuration": {
            "type": "object",
            "description": "Type-specific configuration (purpose, amounts, rates, tenure, etc.)"
          }
        }
      },
      "UpdateProductConfigurationRequest": {
        "type": "object",
        "properties": {
          "configuration": {
            "type": "object",
            "description": "Partial configuration update"
          }
        }
      }
    }
  },
  "paths": {
    "/api/v1/products": {
      "get": {
        "summary": "Get all products",
        "tags": ["Products"],
        "responses": { "200": { "description": "Product list" } }
      }
    },
    "/api/v1/products/merchant/{appId}": {
      "get": {
        "summary": "Get products by merchant (app ID)",
        "tags": ["Products"],
        "parameters": [{ "in": "path", "name": "appId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Products for merchant" } }
      }
    },
    "/api/v1/products/config/{merchantId}/{productId}": {
      "get": {
        "summary": "Get merchant product configuration",
        "tags": ["Products"],
        "parameters": [
          { "in": "path", "name": "merchantId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "productId", "required": true, "schema": { "type": "string" } }
        ],
        "responses": { "200": { "description": "Merchant product configuration" } }
      },
      "put": {
        "summary": "Update merchant product configuration",
        "tags": ["Products"],
        "parameters": [
          { "in": "path", "name": "merchantId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "productId", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/MerchantProductConfigRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Configuration updated" } }
      }
    },
    "/api/v1/products/toggle/{appId}/{productId}": {
      "put": {
        "summary": "Toggle product activation for app",
        "tags": ["Products"],
        "parameters": [
          { "in": "path", "name": "appId", "required": true, "schema": { "type": "string" } },
          { "in": "path", "name": "productId", "required": true, "schema": { "type": "string" } }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ToggleActivationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Activation toggled" },
          "400": { "description": "Validation error" }
        }
      }
    },
    "/api/v1/products/{id}": {
      "get": {
        "summary": "Get product by ID",
        "tags": ["Products"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Product details" },
          "404": { "description": "Product not found" }
        }
      },
      "put": {
        "summary": "Update product",
        "tags": ["Products"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Product updated (or 405 if delegated to server/product-ms)" } }
      },
      "delete": {
        "summary": "Delete product",
        "tags": ["Products"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Product deleted (or 405 if delegated)" } }
      }
    },
    "/api/v1/products/{id}/action": {
      "get": {
        "summary": "Check product action (manage/configure eligibility)",
        "tags": ["Products"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Action eligibility" } }
      }
    },
    "/api/v1/products/{id}/manage": {
      "put": {
        "summary": "Manage product (update name, description, type, status, type-specific fields)",
        "tags": ["Products"],
        "parameters": [{ "in": "path", "name": "id", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProductManageRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Product updated" } }
      }
    },
    "/api/v1/configurations": {
      "post": {
        "summary": "Create product configuration",
        "tags": ["Configurations"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateProductConfigurationRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Configuration created" },
          "400": { "description": "Product ID and Product Type are required" }
        }
      }
    },
    "/api/v1/configurations/{productId}": {
      "get": {
        "summary": "Get product configuration",
        "tags": ["Configurations"],
        "parameters": [{ "in": "path", "name": "productId", "required": true, "schema": { "type": "string" } }],
        "responses": {
          "200": { "description": "Product configuration" },
          "404": { "description": "Configuration not found" }
        }
      },
      "put": {
        "summary": "Update product configuration",
        "tags": ["Configurations"],
        "parameters": [{ "in": "path", "name": "productId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProductConfigurationRequest" }
            }
          }
        },
        "responses": {
          "200": { "description": "Configuration updated" },
          "404": { "description": "Configuration not found" }
        }
      },
      "delete": {
        "summary": "Delete product configuration",
        "tags": ["Configurations"],
        "parameters": [{ "in": "path", "name": "productId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Configuration deleted" } }
      }
    }
  },
  "tags": [
    { "name": "Products", "description": "Product CRUD, merchant config, toggle activation" },
    { "name": "Configurations", "description": "Product configuration (Loan, Mortgage, Savings, Commodity)" }
  ]
}
