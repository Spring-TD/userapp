NODE_ENV=development
PORT=4005
CORS_ORIGINS=http://localhost:3000,http://localhost:4001
LOG_LEVEL=info
# Plata account-ms (GET /api/v1/products catalog). Optional if PLATA_* keys are set (defaults to account-ms-plata in that case).
PLATA_ACCOUNT_SERVICE_URL=https://account-ms-plata.fly.dev
# Alternative name:
# SERVER_PRODUCT_SERVICE_URL=https://account-ms-plata.fly.dev
PLATA_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PLATA_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Database - MongoDB (DigitalOcean or local)
# DigitalOcean: use connection string from Managed MongoDB cluster
# Local: mongodb://localhost:27017/product_ms
MONGODB_URI=mongodb+srv://user:password@host/database?tls=true&authSource=admin
