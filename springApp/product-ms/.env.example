NODE_ENV=development
PORT=4005
CORS_ORIGINS=http://localhost:3000,http://localhost:4001
LOG_LEVEL=info

# Must match client-auth-ms JWT_SECRET when calling product APIs with Bearer tokens (notifications).
JWT_SECRET=your-secret
NOTIFICATIONS_SERVICE_URL=http://localhost:4009
# client-auth-ms profile lookup for filling missing application user details like phone.
CLIENT_AUTH_SERVICE_URL=http://localhost:4001
# Must match client-auth-ms CLIENT_AUTH_INTERNAL_TOKEN.
CLIENT_AUTH_INTERNAL_TOKEN=replace-with-shared-client-auth-internal-token
CLIENT_AUTH_USER_TIMEOUT_MS=10000
# Plata account-ms (GET /api/v1/products catalog). Optional if PLATA_* keys are set (defaults to account-ms-plata in that case).
PLATA_ACCOUNT_SERVICE_URL=https://account-ms-plata.fly.dev
# Alternative name:
# SERVER_PRODUCT_SERVICE_URL=https://account-ms-plata.fly.dev
PLATA_PUBLIC_KEY=pk_live_xxxxxxxxxxxxxxxxxxxxxxxx
PLATA_SECRET_KEY=sk_live_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Loan/mortgage account creation syncs via account-ms POST /api/v1/products/external-accounts (PLATA keys only; no Bearer token).
# PLATA_INTEGRATOR_MERCHANT_ID=spring_merchant_on_plata
# PLATA_INTEGRATOR_MERCHANT_NAME=Spring TD
# Spring app id whose REPAYMENT wallet holds investment/savings principal before Plata credit.
# Defaults to the offering app id when unset.
# PLATA_INTEGRATOR_APP_ID=69f330b2a795ac77103a6d77
# Public gateway callback URL sent to Plata on final loan/mortgage submit. Defaults locally to:
# http://localhost:4005/api/v1/applications/webhooks/plata/loan-workflow
# In production, set either this full URL or ACCOUNT_SERVICE_PUBLIC_URL.
LOAN_WORKFLOW_CALLBACK_URL=https://account-ms.fly.dev/api/v1/applications/webhooks/plata/loan-workflow
# Public callback URL sent to Plata for guarantor KYC completion webhooks.
GUARANTOR_KYC_CALLBACK_URL=https://account-ms.fly.dev/api/v1/applications/webhooks/plata/guarantor-kyc
# Optional shared secret for verifying X-Plata-Signature HMAC-SHA256 webhook signatures.
# Leave empty until Plata enables the shared secret.
PLATA_LOAN_WORKFLOW_WEBHOOK_SECRET=

# Catalog reconcile cron (safety net when Plata product.updated webhooks are missed).
# Defaults to enabled in production; set false to disable. Interval min 60s (default 15m).
# PRODUCT_CATALOG_SYNC_ENABLED=true
# PRODUCT_CATALOG_SYNC_INTERVAL_MS=900000

# wallet-ms internal product wallet provisioning.
WALLET_SERVICE_URL=http://localhost:4004
WALLET_INTERNAL_TOKEN=replace-with-shared-wallet-internal-token
WALLET_SERVICE_HTTP_TIMEOUT_MS=15000

# compliance-ms hosted KYC link creation for loan/mortgage guarantors.
COMPLIANCE_SERVICE_URL=http://localhost:4003
COMPLIANCE_SERVICE_TOKEN=sams_account_service_token
# Server-side BVN lookup for loan/mortgage upstream account creation.
# Must match compliance-ms COMPLIANCE_WALLET_INTERNAL_TOKEN.
COMPLIANCE_WALLET_INTERNAL_TOKEN=replace-with-shared-compliance-wallet-internal-token
COMPLIANCE_BVN_TIMEOUT_MS=10000

# product-ms (guarantor KYC completion callbacks from Fuspay webhooks).
# PRODUCT_SERVICE_URL=http://localhost:4005

# create-app-ms canonical transaction stats for product overview.
CREATE_APP_SERVICE_URL=http://localhost:3002

# Database - MongoDB (DigitalOcean or local)
# DigitalOcean: use connection string from Managed MongoDB cluster
# Local: mongodb://localhost:27017/product_ms
MONGODB_URI=mongodb+srv://user:password@host/database?tls=true&authSource=admin
