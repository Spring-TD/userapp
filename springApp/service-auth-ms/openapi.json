{
  "openapi": "3.0.0",
  "info": {
    "title": "Spring Service Authentication Microservice (SAMS) API",
    "version": "1.0.0",
    "description": "Spring Service-to-service authentication: service registration, credentials, IP whitelist, API keys, user management. Import this spec into Swagger Editor, Postman, or other API tools."
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "CreateServiceRequest": {
        "type": "object",
        "required": ["name", "description"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 100 },
          "description": { "type": "string", "minLength": 10, "maxLength": 500 },
          "version": { "type": "string", "maxLength": 20 },
          "endpoint_url": { "type": "string", "format": "uri" },
          "health_check_url": { "type": "string", "format": "uri" },
          "owner_email": { "type": "string", "format": "email" },
          "tags": { "type": "array", "items": { "type": "string" } },
          "metadata": { "type": "object" }
        }
      },
      "WhitelistIPRequest": {
        "type": "object",
        "required": ["ip_addresses"],
        "properties": {
          "ip_addresses": {
            "type": "array",
            "items": { "type": "string", "description": "IPv4 address or CIDR" }
          }
        }
      },
      "CheckIPAccessRequest": {
        "type": "object",
        "properties": {
          "ip_address": { "type": "string" }
        }
      },
      "CreateCredentialRequest": {
        "type": "object",
        "required": ["credential_type"],
        "properties": {
          "target_service_id": { "type": "string", "format": "uuid" },
          "credential_type": { "type": "string", "enum": ["api_key", "jwt_token", "client_secret"] },
          "expires_in": { "type": "integer", "minimum": 300, "maximum": 31536000 },
          "permissions": { "type": "array", "items": { "type": "string" }, "maxItems": 20 },
          "rate_limit": { "type": "integer", "minimum": 1, "maximum": 10000 }
        }
      },
      "ValidateCredentialRequest": {
        "type": "object",
        "required": ["credential_value"],
        "properties": {
          "credential_value": { "type": "string" },
          "service_id": { "type": "string", "format": "uuid" },
          "requested_permissions": { "type": "array", "items": { "type": "string" } },
          "user_merchant_id": { "type": "string", "maxLength": 50 }
        }
      },
      "VoidCredentialRequest": {
        "type": "object",
        "properties": {
          "reason": { "type": "string" }
        }
      },
      "CreateApiKeyRequest": {
        "type": "object",
        "required": ["name", "environment"],
        "properties": {
          "name": { "type": "string", "minLength": 3, "maxLength": 50 },
          "environment": { "type": "string", "enum": ["test", "live"] },
          "permissions": { "type": "array", "items": { "type": "string" } },
          "expires_in_days": { "type": "integer", "minimum": 1, "maximum": 365 }
        }
      },
      "UpdateProfileRequest": {
        "type": "object",
        "properties": {
          "first_name": { "type": "string" },
          "last_name": { "type": "string" },
          "phone": { "type": "string" }
        }
      },
      "UpdateStatusRequest": {
        "type": "object",
        "properties": {
          "status": { "type": "string" }
        }
      },
      "UpdateCallbacksRequest": {
        "type": "object",
        "properties": {
          "callback_url": { "type": "string", "format": "uri" },
          "error_logs_url": { "type": "string", "format": "uri" }
        }
      }
    }
  },
  "paths": {
    "/api/v1/services/create": {
      "post": {
        "summary": "Create service",
        "tags": ["Services"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateServiceRequest" }
            }
          }
        },
        "responses": {
          "201": { "description": "Service created" },
          "400": { "description": "Validation failed" }
        }
      }
    },
    "/api/v1/services": {
      "get": {
        "summary": "Get all services",
        "tags": ["Services"],
        "responses": { "200": { "description": "Service list" } }
      }
    },
    "/api/v1/services/health": {
      "get": {
        "summary": "Get system health",
        "tags": ["Services"],
        "responses": { "200": { "description": "System health" } }
      }
    },
    "/api/v1/services/{serviceId}": {
      "get": {
        "summary": "Get service by ID",
        "tags": ["Services"],
        "parameters": [{ "in": "path", "name": "serviceId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Service details" } }
      }
    },
    "/api/v1/services/{serviceId}/whitelist-ip": {
      "post": {
        "summary": "Whitelist IPs for service",
        "tags": ["Services"],
        "parameters": [{ "in": "path", "name": "serviceId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/WhitelistIPRequest" }
            }
          }
        },
        "responses": { "200": { "description": "IPs whitelisted" } }
      },
      "get": {
        "summary": "Get whitelisted IPs",
        "tags": ["Services"],
        "parameters": [{ "in": "path", "name": "serviceId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Whitelist" } }
      }
    },
    "/api/v1/services/{serviceId}/check-ip": {
      "post": {
        "summary": "Check IP access",
        "tags": ["Services"],
        "parameters": [{ "in": "path", "name": "serviceId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CheckIPAccessRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Access check result" } }
      }
    },
    "/api/v1/services/{serviceId}/credentials": {
      "post": {
        "summary": "Create credentials for service",
        "tags": ["Services"],
        "parameters": [{ "in": "path", "name": "serviceId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateCredentialRequest" }
            }
          }
        },
        "responses": { "201": { "description": "Credential created" } }
      },
      "get": {
        "summary": "Get service credentials",
        "tags": ["Services"],
        "parameters": [{ "in": "path", "name": "serviceId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Credentials list" } }
      }
    },
    "/api/v1/credentials/validate": {
      "post": {
        "summary": "Validate credential",
        "tags": ["Credentials"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ValidateCredentialRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Validation result" } }
      }
    },
    "/api/v1/credentials/void/{credentialId}": {
      "post": {
        "summary": "Void credential",
        "tags": ["Credentials"],
        "parameters": [{ "in": "path", "name": "credentialId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/VoidCredentialRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Credential voided" } }
      }
    },
    "/api/v1/credentials/{credentialId}/regenerate": {
      "post": {
        "summary": "Regenerate credential",
        "tags": ["Credentials"],
        "parameters": [{ "in": "path", "name": "credentialId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "New credential" } }
      }
    },
    "/api/v1/keys": {
      "get": {
        "summary": "List API keys",
        "tags": ["API Keys"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "API keys list" } }
      },
      "post": {
        "summary": "Create API key",
        "tags": ["API Keys"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateApiKeyRequest" }
            }
          }
        },
        "responses": { "201": { "description": "API key created" } }
      }
    },
    "/api/v1/keys/{keyId}": {
      "delete": {
        "summary": "Revoke API key",
        "tags": ["API Keys"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "keyId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Key revoked" } }
      }
    },
    "/api/v1/user/list": {
      "get": {
        "summary": "Get merchant users",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "User list" } }
      }
    },
    "/api/v1/user/profile": {
      "get": {
        "summary": "Get profile",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "User profile" } }
      },
      "put": {
        "summary": "Update profile",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateProfileRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Profile updated" } }
      }
    },
    "/api/v1/user/{userId}/status": {
      "put": {
        "summary": "Update user status",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateStatusRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Status updated" } }
      }
    },
    "/api/v1/user/deactivate": {
      "post": {
        "summary": "Deactivate account",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "responses": { "200": { "description": "Deactivated" } }
      }
    },
    "/api/v1/user/callbacks": {
      "put": {
        "summary": "Update callback URLs",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateCallbacksRequest" }
            }
          }
        },
        "responses": { "200": { "description": "Callbacks updated" } }
      }
    },
    "/api/v1/user/info/{userId}": {
      "get": {
        "summary": "Get user info (admin)",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "User info" } }
      }
    },
    "/api/v1/user/verify-info/{userId}": {
      "post": {
        "summary": "Verify user info (admin)",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } },
        "responses": { "200": { "description": "Verified" } }
      }
    },
    "/api/v1/user/suspend/{userId}": {
      "put": {
        "summary": "Suspend user (admin)",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "reason": { "type": "string" } } } } } },
        "responses": { "200": { "description": "User suspended" } }
      }
    },
    "/api/v1/user/activate/{userId}": {
      "put": {
        "summary": "Activate user (admin)",
        "tags": ["User"],
        "security": [{ "bearerAuth": [] }],
        "parameters": [{ "in": "path", "name": "userId", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "User activated" } }
      }
    }
  },
  "tags": [
    { "name": "Services", "description": "Service registration, whitelist, credentials" },
    { "name": "Credentials", "description": "Validate, void, regenerate" },
    { "name": "API Keys", "description": "Merchant API key management" },
    { "name": "User", "description": "Profile, status, admin actions" }
  ]
}
