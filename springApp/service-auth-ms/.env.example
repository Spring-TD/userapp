NODE_ENV=development
PORT=3000

# Database - MongoDB (DigitalOcean or local)
# Required. Use connection string from DigitalOcean Managed MongoDB or local: mongodb://localhost:27017/service_auth_ms
MONGODB_URI=mongodb+srv://user:password@host/database?tls=true&authSource=admin

# Redis (optional - in-memory fallback if not set)
REDIS_URL=
REDIS_PASSWORD=

# JWT (required)
JWT_SECRET=your-32-char-minimum-secret-key-here
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d

# Verification emails are sent via notifications-ms (set NOTIFICATIONS_MS_URL; configure Mailtrap/SMTP on that service)
NOTIFICATIONS_MS_URL=http://localhost:3009
FRONTEND_URL=http://localhost:3000

# Joi/env may still expect SMTP placeholders for this service (direct mail is not used if you only use notifications-ms)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=noreply@example.com

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional: Compliance, Payment, Billing service URLs
COMPLIANCE_SERVICE_URL=http://localhost:4003
PAYMENT_SERVICE_URL=http://localhost:3007
BILLING_SERVICE_URL=http://localhost:3006
